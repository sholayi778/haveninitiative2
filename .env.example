# All variables are optional. Without them the site runs in "not connected" mode:
# forms validate and offer an email fallback, and photo selections stay in the browser only.

# Contact + volunteer forms: any endpoint that accepts a JSON POST (e.g. Formspree, Getform, Basin).
# Example: https://formspree.io/f/xxxxxxx
VITE_FORM_ENDPOINT=

# Photo uploads via Cloudinary *unsigned* upload preset (no secret key in the browser).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
